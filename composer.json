{
    "name": "jo/devlib",
    "description": "DevLib — library induk komponen UI/UX (x-dl::*) dan acuan engine untuk proyek Laravel; dibuat oleh Jo, dipakai semua proyek",
    "authors": [{ "name": "Jo" }],
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Devlib\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Devlib\\DevlibServiceProvider"
            ]
        }
    }
}
